  "description": "MCP server for ArcGIS Hub open data platforms - works with any city by configuring the domain",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arcgis-hub-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
